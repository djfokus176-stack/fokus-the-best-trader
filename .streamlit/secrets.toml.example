# Dashboard owner login: configure real value in Streamlit Cloud Secrets ONLY.
# Minimum 12 characters. Do not commit the real password.
APP_ACCESS_PASSWORD = ""

# Mode password works today; to enable the 30-day Google login use "google".
# Keep password configured as a fallback until the Google OIDC setup is tested.
APP_AUTH_MODE = "password"
OWNER_EMAIL = ""
AUTO_SCAN_DEFAULT = true
# Opt in ONLY after testing BotFather token and Chat ID.
# No Telegram messages are sent by default.
PAPER_TELEGRAM_ALERTS_ENABLED = false

# TEMPLATE ONLY — never put live credentials in GitHub.
CAPITAL_API_KEY = ""
CAPITAL_IDENTIFIER = ""
CAPITAL_PASSWORD = ""
CAPITAL_EPIC = "US500"
# Choose DEMO or LIVE for READ-ONLY market data:
CAPITAL_ENV = "DEMO"
# Only if you explicitly need READ-ONLY LIVE market data, set true.
CAPITAL_ALLOW_LIVE = false
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-5.4"
OPENAI_REASONING_EFFORT = "high"
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""

# OPTIONAL Google OIDC — complete ONLY after creating a Google OAuth web client.
# Configure redirect URI in Google Cloud:
# https://fokus-the-best-trader.streamlit.app/oauth2callback
# Uncomment these together and set APP_AUTH_MODE="google".
# [auth]
# redirect_uri = "https://fokus-the-best-trader.streamlit.app/oauth2callback"
# cookie_secret = "GENERATE_A_LONG_RANDOM_UNIQUE_STRING"
# client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
# client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
